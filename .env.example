# Optional. Used for absolute URLs in metadata (Open Graph, etc).
# Defaults to https://airrally.app if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for authentication, profiles, favorites, and venue onboarding.
# Get these from your Supabase project: Settings -> API.
# Both key formats below are safe to expose to the browser — neither is a
# secret. Set whichever your project's dashboard shows you:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Current-generation key format (starts with sb_publishable_). Preferred
# when your project has one — checked first if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy key format (a JWT). Still fully supported — used as a fallback
# when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY isn't set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it from
# client code — see ARCHITECTURE.md. Not required to run the app; only needed
# if a later phase adds server-side admin operations (e.g. an admin API route).
# Still unused as of Phase 4B — payment reconciliation deliberately uses a
# narrowly-scoped SECURITY DEFINER Postgres function instead (see
# ARCHITECTURE.md's Phase 4B section), not this key.
# SUPABASE_SECRET_KEY=your-secret-key

# Required for Phase 4B bookings/payments. Use TEST MODE keys
# (sk_test_.../whsec_...) during development — never live keys. Both are
# server-only: NEVER prefix with NEXT_PUBLIC_, never import from a "use
# client" file. No publishable key is needed — Checkout Sessions are
# created server-side and the browser only redirects to the returned URL,
# it never loads Stripe.js.
STRIPE_SECRET_KEY=sk_test_your-test-mode-secret-key

# From your Stripe Dashboard's webhook endpoint settings (or `stripe
# listen`'s output if using the Stripe CLI locally).
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# --- PayMongo (experimental, TEST MODE only — see ARCHITECTURE.md) -----
#
# A second, switchable payment provider behind the same seam as Stripe
# above. Both are server-only: NEVER prefix with NEXT_PUBLIC_. Use TEST
# MODE keys (sk_test_...) only — never live keys.
PAYMONGO_SECRET_KEY=sk_test_your-test-mode-secret-key

# From a TEST MODE webhook endpoint you create in the PayMongo Dashboard
# (Developers > Webhooks) selecting the checkout_session.payment.paid
# event — the URL you point it at doesn't need to be reachable, this is
# only used to obtain a real signing secret for local signature
# verification (see scripts/verify-paymongo-checkout-flow.ts).
PAYMONGO_WEBHOOK_SECRET=whsec_your-paymongo-webhook-signing-secret

# Which provider lib/actions/checkout.ts actually uses. Defaults to
# "stripe" if unset — set to "paymongo" only when deliberately testing
# the experimental PayMongo path. Never anything else.
ACTIVE_PAYMENT_PROVIDER=stripe
