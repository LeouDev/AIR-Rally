# Optional. Used for absolute URLs in metadata (Open Graph, etc).
# Defaults to https://airrally.app if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for authentication, profiles, favorites, and venue onboarding.
# Get these from your Supabase project: Settings -> API.
# Both key formats below are safe to expose to the browser — neither is a
# secret. Set whichever your project's dashboard shows you:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Current-generation key format (starts with sb_publishable_). Preferred
# when your project has one — checked first if both are set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Legacy key format (a JWT). Still fully supported — used as a fallback
# when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY isn't set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. NEVER prefix this with NEXT_PUBLIC_ and never import it from
# client code — see ARCHITECTURE.md. Not required to run the app; only needed
# if a later phase adds server-side admin operations (e.g. an admin API route).
# SUPABASE_SECRET_KEY=your-secret-key
